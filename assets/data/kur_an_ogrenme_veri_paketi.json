  "quran_combinations": {
    "title": "Kur'an Öğren - Harf Birleştirme",
    "version": "1.0.0",
    "language": "tr",
    "lessons": [
      {
        "id": "comb_01",
        "order": 1,
        "title": "Elif ile Birleştirme",
        "examples": [
          {
            "parts": [
              "ب",
              "ا"
            ],
            "combined": "با",
            "reading": "bâ",
            "note": "Harflerin yazı içinde birleşmesini gösteren başlangıç örneği."
          },
          {
            "parts": [
              "ت",
              "ا"
            ],
            "combined": "تا",
            "reading": "tâ",
            "note": null
          }
        ]
      },
      {
        "id": "comb_02",
        "order": 2,
        "title": "Harekeli Heceleme",
        "examples": [
          {
            "parts": [
              "بَ",
              "تَ"
            ],
            "combined": "بَتَ",
            "reading": "ba-ta",
            "note": "Hareke seslerini ayırt etmeye yönelik eğitim örneği."
          },
          {
            "parts": [
              "مَ",
              "نَ"
            ],
            "combined": "مَنَ",
            "reading": "ma-na",
            "note": "Hareke çalışması."
          }
        ]
      },
      {
        "id": "comb_03",
        "order": 3,
        "title": "Bismillâh Kelimesini Oluşturalım",
        "examples": [
          {
            "parts": [
              "بِ",
              "سْ",
              "مِ"
            ],
            "combined": "بِسْمِ",
            "reading": "bismi",
            "note": "Kur'an'da geçen gerçek kelime."
          }
        ]
      },
      {
        "id": "comb_04",
        "order": 4,
        "title": "Rabb Kelimesini Oluşturalım",
        "examples": [
          {
            "parts": [
              "رَ",
              "بِّ"
            ],
            "combined": "رَبِّ",
            "reading": "rabbi",
            "note": "Kur'an'da geçen gerçek kelime; şedde örneği."
          }
        ]
      }
    ]
  },
